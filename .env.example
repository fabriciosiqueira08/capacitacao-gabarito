# Copie para .env, preencha, e rode `source .env` antes de qualquer comando do Kamal.
#
#   cp .env.example .env && $EDITOR .env && source .env
#
# O .env está no .gitignore. Confira com `git status` antes de commitar:
# ESTE é o arquivo que não pode vazar.

# ── O servidor ────────────────────────────────────────────────────────────────
export SERVER_IP=10.161.42.87          # multipass info servidor
export KAMAL_SSH_USER=ubuntu           # azureuser numa VM da Azure
export SSH_PORT=22                     # 2222 se você usa o encaminhamento de porta do Windows
export SERVER_ARCH=amd64               # arm64 se o seu notebook é Mac M1/M2/M3/M4
export APP_HOST=seunome.test           # o mesmo nome que você pôs no /etc/hosts

# ── Registry ──────────────────────────────────────────────────────────────────
export GHCR_USER=seu-usuario
# PAT (classic) do GitHub com write:packages e read:packages.
export KAMAL_REGISTRY_PASSWORD=ghp_xxxxxxxxxxxxxxxxxxxx

# ── Segredos da aplicação ─────────────────────────────────────────────────────
export RAILS_MASTER_KEY=            # conteúdo de config/master.key
export JWT_SECRET=                  # saída de: bin/rails secret
export AUTOMIC_AUTH_API_DATABASE_PASSWORD=   # invente uma senha longa

# ── Configuração ──────────────────────────────────────────────────────────────
export CORS_ORIGINS=http://localhost:5173
export MAILER_FROM="Capacitação <noreply@exemplo.com>"

# ── SMTP (para o e-mail chegar de verdade) ────────────────────────────────────
export SMTP_ADDRESS=
export SMTP_USERNAME=
export SMTP_PASSWORD=

# ── TLS ───────────────────────────────────────────────────────────────────────
# O certificado autoassinado da Aula 4:
#
#   openssl req -x509 -newkey rsa:2048 -sha256 -days 365 -nodes \
#     -keyout tls/capacita-key.pem -out tls/capacita-cert.pem \
#     -subj "/CN=seunome.test" -addext "subjectAltName=DNS:seunome.test"
#
# Vai o CONTEÚDO do arquivo, não o caminho.
export KAMAL_PROXY_SSL_CERTIFICATE="$(cat tls/capacita-cert.pem)"
export KAMAL_PROXY_SSL_PRIVATE_KEY="$(cat tls/capacita-key.pem)"
