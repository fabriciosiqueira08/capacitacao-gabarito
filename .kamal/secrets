# O Kamal lê este arquivo para resolver os segredos referenciados no deploy.yml.
#
# Aqui NÃO há valor nenhum — só referências a variáveis de ambiente. Elas vêm do
# seu `.env` (`source .env`) quando você roda o Kamal da sua máquina, ou dos
# Secrets do GitHub Actions quando o deploy é pelo pipeline.
# Por isso este arquivo pode ir para o Git sem risco.

# Login no ghcr.io. Da sua máquina, um PAT com write:packages.
# No CI, o GITHUB_TOKEN que o Actions gera sozinho.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Chave mestra do Rails: decripta config/credentials.yml.enc.
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# Senha do Postgres — a mesma para o app e para o accessory.
AUTOMIC_AUTH_API_DATABASE_PASSWORD=$AUTOMIC_AUTH_API_DATABASE_PASSWORD
POSTGRES_PASSWORD=$AUTOMIC_AUTH_API_DATABASE_PASSWORD

# Segredo que assina os JWTs.
JWT_SECRET=$JWT_SECRET

# CORS e remetente do mailer.
CORS_ORIGINS=$CORS_ORIGINS
MAILER_FROM=$MAILER_FROM

# SMTP (envio dos códigos de 6 dígitos).
SMTP_ADDRESS=$SMTP_ADDRESS
SMTP_USERNAME=$SMTP_USERNAME
SMTP_PASSWORD=$SMTP_PASSWORD

# TLS terminado pelo kamal-proxy. Na Aula 4 é um certificado autoassinado;
# numa VPS atrás do Cloudflare, o Origin CA.
KAMAL_PROXY_SSL_CERTIFICATE=$KAMAL_PROXY_SSL_CERTIFICATE
KAMAL_PROXY_SSL_PRIVATE_KEY=$KAMAL_PROXY_SSL_PRIVATE_KEY
